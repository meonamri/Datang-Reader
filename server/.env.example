# Datang Reader - Server Environment Configuration
# Copy this file to .env and fill in your actual values
# IMPORTANT: Never commit .env to version control!

# ===================================================================
# DATANG API CONFIGURATION
# ===================================================================

# API Base URL (no trailing slash)
DATANG_API_BASE_URL=https://datang.my/api/reader/v1

# Reader Credentials
# Format: {school_id}_reader{number}
DATANG_READER_USERNAME=your_username_here
DATANG_READER_PASSWORD=your_password_here

# Device Identification
# Unique identifier for this reader terminal
DATANG_DEVICE_ID=docker-reader-01

# Mock API Mode (for testing without real API)
# Set to 'true' for development/testing, 'false' for production
DATANG_MOCK_API=false

# Host port mapping (the port exposed on the host machine)
# The container always listens on 8080 internally
DATANG_HOST_PORT=8080


# ===================================================================
# IDME MODULE (Optional - Automated IDME Portal Submission)
# ===================================================================
# Set IDME_ENABLED=true to activate automated attendance submission
# to the IDME/MOEIS portal. Teacher credentials are managed via
# the Web UI at http://localhost:8080/idme/settings

# Enable/disable IDME module
IDME_ENABLED=false

# Container timezone (default Asia/Kuala_Lumpur). Cutoff times below are
# interpreted in this zone, so set this to the school's local zone.
TZ=Asia/Kuala_Lumpur

# Daily cutoff times for automatic IDME submission (24h format HH:MM, local time).
# This is a two-session school: upper forms (3-6) attend the morning session and
# lower forms (1-2) the afternoon session, so each session submits at its own
# cutoff. A class is mapped to a session by the leading form number in its class
# string (e.g. '5 UKM' -> Form 5 -> morning). At each cutoff, students in that
# session's forms who haven't scanned are marked absent.
IDME_CUTOFF_TIME_MORNING=12:00   # upper forms (3, 4, 5, 6)
IDME_CUTOFF_TIME_EVENING=16:00   # lower forms (1, 2)
# IDME_CUTOFF_TIME (the old single cutoff) is still honoured as the morning
# fallback if IDME_CUTOFF_TIME_MORNING is unset.
# Set a cutoff to "off" (or none/disabled/-) to run a single session, e.g. a
# one-session school: IDME_CUTOFF_TIME_EVENING=off.

# Scheduler auto-confirm (safety gate).
#   false (default) = the daily scheduler saves re-editable DRAFTS
#                     (MENUNGGU PENGESAHAN) so a human confirms each morning.
#   true            = auto-CONFIRMS locked records (TELAH DISAHKAN) daily and
#                     unattended (hard to reverse). Set true ONLY after a
#                     supervised period. See server/IDME_DEPLOY.md.
IDME_SCHEDULER_CONFIRM=false

# --- Non-school day detection (weekends + holidays) ---
# Neither the cutoff submission nor the Telegram prompt should fire on a
# non-school day. Two cheap signals decide it before any portal login:
#
# Weekend days that are never school days — weekday names or 0-6 indices
# (Mon=0 .. Sun=6), comma/space separated. Default fri,sat (this school's
# weekend). Used by the Telegram prompt's weekday guard.
IDME_WEEKEND_DAYS=fri,sat
# Cheap holiday signal shared by the cutoff submission AND the Telegram prompt:
# the fewest distinct students who must have scanned today for it to count as a
# school day. Below this — a holiday, or a down reader that would otherwise mark
# the whole school absent — the day is skipped WITHOUT a portal login. Evaluated
# live each day; the count resets at local (TZ) midnight. Default 5.
IDME_MIN_SCANS_FOR_SCHOOL_DAY=5

# Fernet encryption key for teacher password storage
# Generate one: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# IMPORTANT: Generate once, never change (or all stored passwords become invalid)
IDME_ENCRYPTION_KEY=

# Debug mode - saves screenshots during IDME automation (useful for troubleshooting)
IDME_DEBUG=false

# -------------------------------------------------------------------
# Telegram bot - per-student absence reason collection (optional)
# -------------------------------------------------------------------
# When enabled, a Telegram bot DMs each class teacher their current absentee list
# BEFORE the cutoff so they can tap a reason per student (e.g. DEMAM, MENGIKUT
# KELUARGA). The cutoff submission then uses those reasons; any student left
# untouched keeps the default PONTENG (MALAS KE SEKOLAH). Off by default and
# independent of the submission scheduler.
#
# Setup: create a bot with @BotFather, paste its token below, and set a shared
# access passphrase. Each teacher then links their own chat from inside Telegram:
# search the bot, send /start, type the passphrase, and tap their class. Only
# unlinked classes are offered; after 3 wrong passphrase tries a chat is locked
# for ~1 hour. An admin can unlink a teacher from the IDME settings UI (e.g. to
# move to a new phone). Requires outbound HTTPS to api.telegram.org.
IDME_TELEGRAM_ENABLED=false
IDME_TELEGRAM_BOT_TOKEN=
# Shared passphrase teachers type to the bot to link their chat (required when
# the bot is enabled). Pick something not easily guessed; rotate by changing it.
IDME_TELEGRAM_PASSPHRASE=

# Admin's Telegram chat/user id (numeric — get it from @userinfobot). When set,
# the bot DMs this chat whenever a student is marked "Hadir (lupa kad)" more than
# IDME_HADIR_LIMIT times within the rolling IDME_HADIR_WINDOW_DAYS window. Leave
# empty to disable that alert (the Hadir button itself still works).
IDME_TELEGRAM_ADMIN_CHAT_ID=

# "Hadir (lupa kad)" present-override policy. A teacher can mark a prompted
# absentee as actually present (forgot their RFID card): the student is dropped
# from that day's IDME submission AND the tap is recorded. When a student's
# distinct Hadir days in the trailing window exceed the limit, the admin above is
# notified (the override is never blocked — a present student must not be marked
# absent). Rolling look-back, not fixed calendar cycles.
IDME_HADIR_LIMIT=3
IDME_HADIR_WINDOW_DAYS=14

# When the bot prompts teachers (24h HH:MM, local time), per session. Must be
# before that session's cutoff so reasons are collected in time. Set a value to
# "off" (or none/-) to disable the prompt for that session.
IDME_TELEGRAM_PROMPT_TIME_MORNING=10:00   # upper forms (3, 4, 5, 6)
IDME_TELEGRAM_PROMPT_TIME_EVENING=15:00   # lower forms (1, 2)

# Portal school-day pre-check lead: this many hours before the EARLIEST prompt, a
# single MOEIS login checks whether today is a school day (catching public
# holidays the weekend/scan gates above can't). One login per school day, shared
# by both sessions; skipped entirely on weekends / low-scan days. Default 1 —
# students have already scanned by then, so the scan gate is meaningful; a longer
# lead would run before they arrive.
IDME_TELEGRAM_PRECHECK_LEAD_HOURS=1
